{
  "name": "caloriee",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:tunnel": "expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:dev:android": "npx eas-cli build --platform android --profile development",
    "build:dev:ios": "npx eas-cli build --platform ios --profile development",
    "build:sim:ios": "npx eas-cli build --platform ios --profile development-simulator",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:prod:android": "npx eas-cli build --platform android --profile production",
    "build:prod:ios": "npx eas-cli build --platform ios --profile production"
  },
  "dependencies": {
